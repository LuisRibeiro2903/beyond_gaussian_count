+def validate_training_topology(gaussians, iteration, mutation, roots=None, before_nodes=None):
+    """Fail-fast diagnostic validation for hierarchy-mutating smoke runs."""
+    started = time.perf_counter()
+    if roots is None:
+        report = validate_topology(
+            gaussians.nodes,
+            active_size=gaussians.size,
+            skybox_rows=gaussians.skybox_points,
+            root=gaussians.skybox_points,
+        )
+        scope = "global"
+        root_ids = None
+    else:
+        root_ids = roots.detach().cpu().to(torch.int64).tolist()
+        report = validate_topology(
+            gaussians.nodes,
+            active_size=gaussians.size,
+            skybox_rows=gaussians.skybox_points,
+            subtree_roots=root_ids,
+        )
+        scope = "affected-subtrees"
+
+    changed_count = None
+    changed_examples = None
+    if before_nodes is not None:
+        overlap = min(len(before_nodes), gaussians.size)
+        changed = torch.nonzero(
+            torch.any(before_nodes[:overlap] != gaussians.nodes[:overlap], dim=1),
+            as_tuple=True,
+        )[0]
+        changed_count = int(len(changed)) + max(0, gaussians.size - len(before_nodes))
+        changed_examples = changed[:100].detach().cpu().tolist()
+
+    event = {
+        "event": "ALOD_TOPOLOGY_VALIDATION",
+        "iteration": int(iteration),
+        "mutation": mutation,
+        "scope": scope,
+        "valid": report.valid,
+        "active_size": gaussians.size,
+        "skybox_rows": gaussians.skybox_points,
+        "affected_roots": root_ids,
+        "reachable_nodes": report.reachable_nodes,
+        "checked_edges": report.checked_edges,
+        "mismatch_counts": report.mismatch_counts,
+        "mismatches": report.mismatches[:100],
+        "changed_row_count": changed_count,
+        "changed_row_examples": changed_examples,
+        "duration_seconds": time.perf_counter() - started,
+    }
+    print(json.dumps(event, sort_keys=True), flush=True)
+    if not report.valid:
+        raise RuntimeError("ALoD topology invariant failed: " + json.dumps(event, sort_keys=True))
+    return report
+
+
 
