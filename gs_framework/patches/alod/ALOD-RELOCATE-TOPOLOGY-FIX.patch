+    def _repair_relocated_topology_metadata(self, roots, size):
+        """Rebuild parent/depth metadata below locally mutated forward roots."""
+        if len(roots) == 0:
+            return
+        roots = torch.unique(roots.to(torch.int64))
+        root_depths = self.nodes[roots, hierarchy_node_depth].to(torch.int64)
+        roots = roots[torch.argsort(root_depths)]
+        for root_tensor in roots:
+            root = int(root_tensor.item())
+            if root < self.skybox_points or root >= size:
+                raise RuntimeError(f"relocation repair root out of range: {root}")
+            stack = [root]
+            visited = set()
+            while stack:
+                parent = stack.pop()
+                if parent in visited:
+                    raise RuntimeError(f"cycle in relocated subtree at node {parent}")
+                visited.add(parent)
+                child_count = int(self.nodes[parent, hierarchy_node_child_count].item())
+                if child_count < 0:
+                    raise RuntimeError(f"negative child count at node {parent}")
+                if child_count == 0:
+                    continue
+                child = int(self.nodes[parent, hierarchy_node_first_child].item())
+                children = []
+                for child_number in range(child_count):
+                    if child < self.skybox_points or child >= size:
+                        raise RuntimeError(
+                            f"relocated child out of range: parent={parent}, child={child}"
+                        )
+                    children.append(child)
+                    self.nodes[child, hierarchy_node_parent] = parent
+                    self.nodes[child, hierarchy_node_depth] = (
+                        self.nodes[parent, hierarchy_node_depth] + 1
+                    )
+                    sibling = int(self.nodes[child, hierarchy_node_next_sibling].item())
+                    if child_number + 1 < child_count:
+                        if sibling == 0:
+                            raise RuntimeError(f"short sibling chain at node {parent}")
+                        child = sibling
+                    elif sibling != 0:
+                        raise RuntimeError(f"unterminated sibling chain at node {parent}")
+                stack.extend(reversed(children))
     
