+#!/usr/bin/env python
+from __future__ import annotations
+
+import argparse
+import json
+import sys
+from pathlib import Path
+
+import numpy as np
+import torch
+
+
+def parse_args():
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--official-run", type=Path, required=True)
+    parser.add_argument("--oracle", type=Path, required=True)
+    parser.add_argument("--trajectory", type=Path, required=True)
+    parser.add_argument("--project-source", type=Path, required=True)
+    parser.add_argument("--output-dir", type=Path, required=True)
+    return parser.parse_args()
+
+
+def rows(path: Path):
+    return [json.loads(line) for line in path.read_text().splitlines() if line.strip()]
+
+
+def max_abs(a, b):
+    return float(np.max(np.abs(np.asarray(a, dtype=np.float64) - np.asarray(b, dtype=np.float64))))
+
+
+def main():
+    args = parse_args()
+    args.output_dir.mkdir(parents=True, exist_ok=True)
+    sys.path.insert(0, str(args.project_source))
+    from benchmarks.benchmark_real_scene import load_camera_path
+    from scene_runtime.citygaussian import citygaussian_official_camera_from_c2w
+
+    trajectory = load_camera_path(args.trajectory)
+    official_cameras = {int(row["frame_index"]): row for row in json.loads((args.official_run / "camera_matrices.json").read_text())}
+    camera_table = []
+    for index, official in sorted(official_cameras.items()):
+        spec = trajectory.cameras[index]
+        project = citygaussian_official_camera_from_c2w(
+            torch.from_numpy(spec.c2w),
+            torch.from_numpy(spec.K),
+            width=spec.width,
+            height=spec.height,
+        )
+        row = {
+            "frame_index": index,
+            "camera_id": official["camera_id"],
+            "camera_position_max_abs_difference": max_abs(official["camera_position"], project.camera_center.tolist()),
+            "fov_x_abs_difference": abs(float(official["fov_x"]) - float(project.fov_x)),
+            "fov_y_abs_difference": abs(float(official["fov_y"]) - float(project.fov_y)),
+            "world_view_max_abs_difference": max_abs(official["world_view_transform"], project.world_view_transform.tolist()),
+            "projection_max_abs_difference": max_abs(official["projection_transform"], project.projection_matrix.tolist()),
+            "full_projection_max_abs_difference": max_abs(official["full_projection_transform"], project.full_proj_transform.tolist()),
+        }
+        row["within_tolerance"] = (
+            row["camera_position_max_abs_difference"] <= 5e-6
+            and row["fov_x_abs_difference"] <= 1e-6
+            and row["fov_y_abs_difference"] <= 1e-6
+            and row["world_view_max_abs_difference"] <= 1e-6
+            and row["projection_max_abs_difference"] <= 1e-6
+            and row["full_projection_max_abs_difference"] <= 1e-6
+        )
+        camera_table.append(row)
+    camera_summary = {
+        "status": "pass" if all(row["within_tolerance"] for row in camera_table) else "fail",
+        "camera_count": len(camera_table),
+        "tolerances": {
+            "matrix_and_fov": 1e-6,
+            "derived_camera_position": 5e-6,
+            "note": "The official MiniCam recomputes camera_center by a float32 GPU inverse; the project comparison recomputes it on CPU from the identical world-view matrix.",
+        },
+        "max_differences": {
+            key: max(float(row[key]) for row in camera_table)
+            for key in camera_table[0]
+            if key.endswith("difference")
+        },
+        "frames": camera_table,
+    }
+    (args.output_dir / "camera_parity.json").write_text(json.dumps(camera_summary, indent=2, sort_keys=True) + "\n")
+
+    oracle = json.loads(args.oracle.read_text())
+    expected = {int(row["trajectory_index"]): row for row in oracle["frames"]}
+    actual = {int(row["trajectory_frame_index"]): row for row in rows(args.official_run / "frames.jsonl")}
+    fields = [
+        ("visible_cell_ids", "visible_cell_ids"),
+        ("selected_lod_by_cell", "selected_lod_by_cell"),
+        ("selected_level_label_by_cell", "selected_level_label_by_cell"),
+        ("selected_gaussian_count_by_cell", "selected_gaussian_count_by_cell"),
+        ("selected_cell_count_by_level", "selected_cell_count_by_level"),
+        ("selected_gaussian_count_by_level", "selected_gaussian_count_by_level"),
+        ("total_selected_gaussian_count", "total_selected_gaussian_count"),
+        ("nearest_cell_id", "nearest_cell_id"),
+        ("fallback_changed_mask", "fallback_changed_mask"),
+    ]
+    parity_table = []
+    for index in sorted(expected):
+        exp = expected[index]
+        got = actual[index]
+        checks = {name: got[actual_name] == exp[name] for name, actual_name in fields}
+        parity_table.append(
+            {
+                "frame_index": index,
+                "camera_id": got["camera_id"],
+                "visible_cells_equal": checks["visible_cell_ids"],
+                "lod_assignment_equal": checks["selected_lod_by_cell"] and checks["selected_level_label_by_cell"],
+                "selected_counts_equal": (
+                    checks["selected_gaussian_count_by_cell"]
+                    and checks["selected_cell_count_by_level"]
+                    and checks["selected_gaussian_count_by_level"]
+                    and checks["total_selected_gaussian_count"]
+                ),
+                "nearest_cell_equal": checks["nearest_cell_id"],
+                "fallback_equal": checks["fallback_changed_mask"],
+                "exact": all(checks.values()),
+                "field_checks": checks,
+            }
+        )
+    selection_summary = {
+        "status": "pass" if all(row["exact"] for row in parity_table) else "fail",
+        "exact_camera_count": sum(bool(row["exact"]) for row in parity_table),
+        "camera_count": len(parity_table),
+        "required_result": "12/12 exact",
+        "frames": parity_table,
+    }
+    (args.output_dir / "selected_set_parity.json").write_text(json.dumps(selection_summary, indent=2, sort_keys=True) + "\n")
+    if camera_summary["status"] != "pass" or selection_summary["status"] != "pass":
+        raise SystemExit(1)
+
+
+if __name__ == "__main__":
+    main()

