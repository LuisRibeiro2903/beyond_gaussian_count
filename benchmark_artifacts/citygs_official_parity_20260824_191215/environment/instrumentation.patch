+#!/usr/bin/env python
+"""Non-timed twelve-camera render from the clean canonical gsplat source."""
+
+from __future__ import annotations
+
+import argparse
+import json
+import sys
+from pathlib import Path
+
+import numpy as np
+import torch
+
+
+ORACLE_INDICES = [0, 131, 262, 392, 523, 654, 785, 916, 1047, 1177, 1308, 1439]
+
+
+def main():
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--project-source", type=Path, required=True)
+    parser.add_argument("--trajectory", type=Path, required=True)
+    parser.add_argument("--finest", type=Path, required=True)
+    parser.add_argument("--middle", type=Path, required=True)
+    parser.add_argument("--coarsest", type=Path, required=True)
+    parser.add_argument("--output-dir", type=Path, required=True)
+    args = parser.parse_args()
+    sys.path.insert(0, str(args.project_source))
+    from benchmarks.benchmark_real_scene import (
+        load_camera_path,
+        load_config,
+        load_scene_for_benchmark,
+        make_frame_camera,
+        make_render_settings,
+    )
+    from scene_runtime import GsplatRenderer
+
+    if not torch.cuda.is_available():
+        raise RuntimeError("CUDA required")
+    device = torch.device("cuda", 0)
+    config = load_config("CG-LOD-RELEASE")
+    path = load_camera_path(args.trajectory)
+    scene, stats = load_scene_for_benchmark(
+        config,
+        [args.finest, args.middle, args.coarsest],
+        device,
+    )
+    renderer = GsplatRenderer(device)
+    args.output_dir.mkdir(parents=True, exist_ok=True)
+    records = []
+    with torch.no_grad():
+        for index in ORACLE_INDICES:
+            spec = path.cameras[index]
+            camera = make_frame_camera(spec, device)
+            settings = make_render_settings(config, spec, sh_degree=stats.sh_degree)
+            active = scene.prepare_frame(camera, settings)
+            result = renderer.render(active, camera, settings, log_gpu_events=False, measure_time=False)
+            torch.cuda.synchronize()
+            rgb = result.image.detach().cpu().numpy().astype(np.float32)
+            alpha = result.alpha.detach().cpu().numpy().astype(np.float32)
+            np.save(args.output_dir / f"frame_{index:04d}_rgb.npy", rgb)
+            np.save(args.output_dir / f"frame_{index:04d}_alpha.npy", alpha)
+            records.append(
+                {
+                    "frame_index": index,
+                    "camera_id": spec.camera_id,
+                    "selected_gaussian_count": int(active.num_gaussians),
+                    "finite_rgb": bool(np.isfinite(rgb).all()),
+                    "finite_alpha": bool(np.isfinite(alpha).all()),
+                }
+            )
+    (args.output_dir / "summary.json").write_text(
+        json.dumps(
+            {
+                "source_commit": "cfc2136459dd63cc47dc3acfde55a3d72a4d8bba",
+                "execution_worktree_head": "0c977626885384ad8b2e73ba83e8d57a08d2188e",
+                "source_difference_from_canonical_commit": "documentation-only memo",
+                "timed": False,
+                "frames": records,
+            },
+            indent=2,
+            sort_keys=True,
+        )
+        + "\n"
+    )
+
+
+if __name__ == "__main__":
+    main()

