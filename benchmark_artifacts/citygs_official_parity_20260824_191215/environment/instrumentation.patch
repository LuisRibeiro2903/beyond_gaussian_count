+#!/usr/bin/env python
+from __future__ import annotations
+
+import argparse
+import json
+import math
+from pathlib import Path
+
+import matplotlib.pyplot as plt
+import numpy as np
+from skimage.metrics import structural_similarity
+
+
+ORACLE_INDICES = [0, 131, 262, 392, 523, 654, 785, 916, 1047, 1177, 1308, 1439]
+
+
+def psnr(a: np.ndarray, b: np.ndarray) -> float:
+    mse = float(np.mean((a.astype(np.float64) - b.astype(np.float64)) ** 2))
+    return float("inf") if mse == 0 else 10.0 * math.log10(1.0 / mse)
+
+
+def stats(values):
+    finite = [float(v) for v in values if math.isfinite(float(v))]
+    return {
+        "mean": float(np.mean(finite)),
+        "min": float(np.min(finite)),
+        "max": float(np.max(finite)),
+    }
+
+
+def main():
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--official-images", type=Path, required=True)
+    parser.add_argument("--gsplat-images", type=Path, required=True)
+    parser.add_argument("--output-dir", type=Path, required=True)
+    args = parser.parse_args()
+    args.output_dir.mkdir(parents=True, exist_ok=True)
+    rows = []
+    loaded = {}
+    for index in ORACLE_INDICES:
+        official_rgb = np.load(args.official_images / f"frame_{index:04d}_rgb.npy")
+        official_alpha = np.load(args.official_images / f"frame_{index:04d}_alpha.npy")
+        gsplat_rgb = np.load(args.gsplat_images / f"frame_{index:04d}_rgb.npy")
+        gsplat_alpha = np.load(args.gsplat_images / f"frame_{index:04d}_alpha.npy")
+        if official_rgb.shape != gsplat_rgb.shape or official_alpha.shape != gsplat_alpha.shape:
+            raise ValueError(f"Shape mismatch at frame {index}")
+        loaded[index] = (official_rgb, official_alpha, gsplat_rgb, gsplat_alpha)
+        rgb_diff = np.abs(official_rgb - gsplat_rgb)
+        alpha_diff = np.abs(official_alpha - gsplat_alpha)
+        off_coverage = official_alpha[..., 0] > 1e-4
+        gs_coverage = gsplat_alpha[..., 0] > 1e-4
+        union = np.logical_or(off_coverage, gs_coverage)
+        intersection = np.logical_and(off_coverage, gs_coverage)
+        clipped_official = np.clip(official_rgb, 0.0, 1.0)
+        clipped_gsplat = np.clip(gsplat_rgb, 0.0, 1.0)
+        rows.append(
+            {
+                "frame_index": index,
+                "finite_rgb": bool(np.isfinite(official_rgb).all() and np.isfinite(gsplat_rgb).all()),
+                "finite_alpha": bool(np.isfinite(official_alpha).all() and np.isfinite(gsplat_alpha).all()),
+                "official_rgb_range": [float(official_rgb.min()), float(official_rgb.max())],
+                "gsplat_rgb_range": [float(gsplat_rgb.min()), float(gsplat_rgb.max())],
+                "rgb_max_absolute_difference_raw": float(rgb_diff.max()),
+                "rgb_mean_absolute_difference_raw": float(rgb_diff.mean()),
+                "rgb_psnr_raw_data_range_1": psnr(official_rgb, gsplat_rgb),
+                "rgb_psnr_clipped_0_1": psnr(clipped_official, clipped_gsplat),
+                "rgb_ssim_clipped_0_1": float(
+                    structural_similarity(
+                        clipped_official,
+                        clipped_gsplat,
+                        channel_axis=2,
+                        data_range=1.0,
+                    )
+                ),
+                "alpha_max_absolute_difference": float(alpha_diff.max()),
+                "alpha_mean_absolute_difference": float(alpha_diff.mean()),
+                "alpha_psnr_data_range_1": psnr(official_alpha, gsplat_alpha),
+                "official_coverage_fraction_alpha_gt_1e_4": float(off_coverage.mean()),
+                "gsplat_coverage_fraction_alpha_gt_1e_4": float(gs_coverage.mean()),
+                "coverage_jaccard": float(intersection.sum() / max(int(union.sum()), 1)),
+                "official_only_coverage_fraction": float(np.logical_and(off_coverage, ~gs_coverage).mean()),
+                "gsplat_only_coverage_fraction": float(np.logical_and(gs_coverage, ~off_coverage).mean()),
+            }
+        )
+    summary = {
+        "record_kind": "cross_backend_implementation_similarity",
+        "comparison": "official GraphDECO OFFICIAL-CITYGS-LOD-RELEASE vs project gsplat CG-LOD-RELEASE",
+        "not_ground_truth_quality": True,
+        "alpha_method_official": "second non-timed GraphDECO render with constant-one RGB and black background",
+        "frame_count": len(rows),
+        "all_rgb_finite": all(row["finite_rgb"] for row in rows),
+        "all_alpha_finite": all(row["finite_alpha"] for row in rows),
+        "aggregate": {
+            key: stats([row[key] for row in rows])
+            for key in (
+                "rgb_max_absolute_difference_raw",
+                "rgb_mean_absolute_difference_raw",
+                "rgb_psnr_raw_data_range_1",
+                "rgb_psnr_clipped_0_1",
+                "rgb_ssim_clipped_0_1",
+                "alpha_max_absolute_difference",
+                "alpha_mean_absolute_difference",
+                "alpha_psnr_data_range_1",
+                "official_coverage_fraction_alpha_gt_1e_4",
+                "gsplat_coverage_fraction_alpha_gt_1e_4",
+                "coverage_jaccard",
+                "official_only_coverage_fraction",
+                "gsplat_only_coverage_fraction",
+            )
+        },
+        "frames": rows,
+    }
+    (args.output_dir / "cross_backend_image_comparison.json").write_text(
+        json.dumps(summary, indent=2, sort_keys=True, allow_nan=False) + "\n"
+    )
+
+    representatives = [0, 654, 1308]
+    figure, axes = plt.subplots(len(representatives), 4, figsize=(16, 9), constrained_layout=True)
+    for row_index, frame_index in enumerate(representatives):
+        official_rgb, official_alpha, gsplat_rgb, gsplat_alpha = loaded[frame_index]
+        panels = [
+            (np.clip(official_rgb, 0.0, 1.0), "Official GraphDECO RGB"),
+            (np.clip(gsplat_rgb, 0.0, 1.0), "Project gsplat RGB"),
+            (np.clip(np.abs(official_rgb - gsplat_rgb) * 5.0, 0.0, 1.0), "|RGB diff| ×5"),
+            (
+                np.concatenate(
+                    [np.clip(official_alpha, 0.0, 1.0), np.clip(gsplat_alpha, 0.0, 1.0), np.zeros_like(official_alpha)],
+                    axis=2,
+                ),
